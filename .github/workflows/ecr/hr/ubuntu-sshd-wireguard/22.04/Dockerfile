FROM 134148934511.dkr.ecr.us-east-1.amazonaws.com/hr/ubuntu-sshd:22.04

COPY rootfs/ /

ENV ECR=134148934511.dkr.ecr.us-east-1.amazonaws.com/hr/ubuntu-sshd-wireguard:22.04

RUN apt \
      update \
    && \
    DEBIAN_FRONTEND=noninteractive \
    apt \
      install \
        -y \
        --no-install-recommends \
        iproute2 \
        wireguard-tools \
        zip; \
    rm \
      -rf \
      /var/lib/apt/lists/* \
    && \
    chmod \
      0600 \
      /etc/wireguard/wg0.conf \
      /etc/wireguard/wg0/client.conf \
    && \
    wg \
      genkey \
        | \
          install \
            -D \
            --mode="0600" \
            /dev/stdin \
            /etc/wireguard/wg0/private.key; \
    wg \
      pubkey \
      </etc/wireguard/wg0/private.key \
        | \
          install \
            --mode="0600" \
            /dev/stdin \
            /etc/wireguard/wg0/public.key; \
    wg \
      genkey \
        | \
          install \
            -D \
            --mode="0600" \
            /dev/stdin \
            /etc/wireguard/wg0/client/private.key; \
    wg \
      pubkey \
      </etc/wireguard/wg0/client/private.key \
        | \
          install \
            --mode="0600" \
            /dev/stdin \
            /etc/wireguard/wg0/client/public.key; \
    xargs \
      --replace='*' \
      sed \
        -i \
        's|\[SERVER_PRIVATE_KEY\]|*|' \
        /etc/wireguard/wg0.conf \
      </etc/wireguard/wg0/private.key; \
    xargs \
      --replace='*' \
      sed \
        -i \
        's|\[CLIENT_PUBLIC_KEY\]|*|' \
        /etc/wireguard/wg0.conf \
      </etc/wireguard/wg0/client/public.key \
    && \
    install \
      -D \
      --mode="0600" \
      /etc/wireguard/wg0/client.conf \
      /tmp/wireguard-client-conf/client.conf; \
    install \
      --mode="0600" \
      /etc/wireguard/wg0/client/private.key \
      /tmp/wireguard-client-conf/client.private.key; \
    install \
      --mode="0600" \
      /etc/wireguard/wg0/public.key \
      /tmp/wireguard-client-conf/server.public.key; \
    zip \
      -jr \
      /tmp/wireguard-client-conf.zip \
      /tmp/wireguard-client-conf; \
    install \
      --owner="ops" \
      --group="ops" \
      --mode="0644" \
      /tmp/wireguard-client-conf.zip \
      /home/ops/wireguard-client-conf.zip; \
    rm \
      -rf \
      /tmp/wireguard-client-conf \
      /tmp/wireguard-client-conf.zip
