FROM 134148934511.dkr.ecr.us-east-1.amazonaws.com/hr/ubuntu-sshd:22.04

COPY rootfs/ /

ENV ECR=134148934511.dkr.ecr.us-east-1.amazonaws.com/hr/ubuntu-sshd-openvpn:22.04

RUN apt-get \
      update \
    && \
    DEBIAN_FRONTEND=noninteractive \
    apt-get \
      install \
        -y \
        --no-install-recommends \
        openvpn \
        easy-rsa \
        zip; \
    rm \
      -rf \
      /var/lib/apt/lists/* \
    && \
    ln \
      -s \
        /usr/share/easy-rsa/easyrsa \
        /usr/local/bin/ \
    && \
    export \
      EASYRSA_PKI="/etc/openvpn/ca/pki"; \
    make-cadir \
      /etc/openvpn/ca; \
    easyrsa \
      init-pki; \
    easyrsa \
      --batch \
      build-ca \
        nopass; \
    easyrsa \
      --batch \
      gen-req \
        server \
          nopass; \
    easyrsa \
      --batch \
      gen-dh; \
    easyrsa \
      --batch \
      sign-req \
        server \
        server; \
    install \
      --mode="0600" \
      /etc/openvpn/ca/pki/dh.pem \
      /etc/openvpn/server/dh.pem; \
    install \
      --mode="0600" \
      /etc/openvpn/ca/pki/ca.crt \
      /etc/openvpn/server/ca.crt; \
    install \
      --mode="0600" \
      /etc/openvpn/ca/pki/issued/server.crt \
      /etc/openvpn/server/server.crt; \
    install \
      --mode="0600" \
      /etc/openvpn/ca/pki/private/server.key \
      /etc/openvpn/server/server.key; \
    easyrsa \
      --batch \
        gen-req \
          client \
          nopass; \
    easyrsa \
      --batch \
      sign-req \
        client \
        client; \
    install \
      --mode="0600" \
      /etc/openvpn/ca/pki/ca.crt \
      /etc/openvpn/client/ca.crt; \
    install \
      --mode="0600" \
      /etc/openvpn/ca/pki/issued/client.crt \
      /etc/openvpn/client/client.crt; \
    install \
      --mode="0600" \
      /etc/openvpn/ca/pki/private/client.key \
      /etc/openvpn/client/client.key \
    && \
    install \
      -D \
      --mode="0664" \
      /etc/openvpn/client.conf \
      /tmp/openvpn-client-conf/client.conf; \
    install \
      --mode="0600" \
      /etc/openvpn/client/ca.crt \
      /tmp/openvpn-client-conf/ca.crt; \
    install \
      --mode="0600" \
      /etc/openvpn/client/client.crt \
      /tmp/openvpn-client-conf/client.crt; \
    install \
      --mode="0600" \
      /etc/openvpn/client/client.key \
      /tmp/openvpn-client-conf/client.key; \
    zip \
      -jr \
      /tmp/openvpn-client-conf.zip \
      /tmp/openvpn-client-conf; \
    install \
      --owner="ops" \
      --group="ops" \
      --mode="0644" \
      /tmp/openvpn-client-conf.zip \
      /home/ops/openvpn-client-conf.zip; \
    rm \
      -rf \
      /tmp/openvpn-client-conf \
      /tmp/openvpn-client-conf.zip
