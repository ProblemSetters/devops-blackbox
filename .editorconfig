# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 1234567890
trim_trailing_whitespace = true

[Makefile.{blackbox,workflow}]
indent_size = 4
indent_style = tab

[*.md]
indent_size = 4
