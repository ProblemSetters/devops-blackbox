#!/usr/bin/env bash
# @file framework/module/abstract/check/provision.step
# @brief https://github.com/ProblemSetters/devops-blackbox/blob/2404/framework/module/abstract/check/provision.step
# @description Abstract module "check" action "provision" step

# @section blackbox.framework.module.abstract.check.*

# Implements a common logical part of "check" action "provision" step that each module inherits
#
# @arg $1 type=...mixed Step args
#
# @example
#   #!/usr/bin/env bash
#   # Example of a module "check" action "provision" step inheriting an abstraction
#   blackbox.module.my-module.check.provision() {
#     # do something (if needed), then specify where the abstraction should be applied
#     : <<< blackbox.framework.module.abstract.check.provision:step
#     # do something (if needed)
#   }
blackbox.framework.module.abstract.check.provision() {
  # shellcheck disable=SC2034
  typeset -a args=("$@")

  printf "\n"

  {
    blackbox.framework.trace "${FUNCNAME[0]}" "$*" <<<"provision"
  }

  if ( ! blackbox.framework.flag.enabled STEP_PROVISION ); then
    (
      printf "\033[0;36m** BLACKBOX_FLAG__STEP_PROVISION:\033[0m %s\n" "$BLACKBOX_FLAG__STEP_PROVISION"
      printf "\033[0;37m--\033[0m\n"
      cat -n <<<"BLACKBOX_FLAG__STEP_PROVISION=no"
      printf "\033[0;37m--\033[0m\n"
    ) | if ( tput setaf &>/dev/null ); then cat; else sed "s/\x1b\[[0-9;]*m//g"; fi

    return
  fi

  docker ps -aq | xargs -r docker rm -f >/dev/null

  if ( blackbox.framework.flag.enabled "DEBUG_MODE" ); then
    docker system prune -af --volumes
  fi

  if ( grep -q '^init$' <(ps -p 1 -o comm=) ); then
    docker run -di --hostname="$BLACKBOX_SPAWN" --name="$BLACKBOX_SPAWN" --privileged --cgroupns=host --volume="${BLACKBOX_USER_QUESTION_DIR}:${BLACKBOX_USER_QUESTION_DIR}:rw" --volume="${BLACKBOX_STORAGE_DIR}:${BLACKBOX_STORAGE_DIR}:rw" --volume="${BLACKBOX_ECR_TOKEN_DIR}:${BLACKBOX_ECR_TOKEN_DIR}:ro" "134148934511.dkr.ecr.us-east-1.amazonaws.com/hr/blackbox_2404:${BLACKBOX_MODULE_NAME}"
  else
    docker run -di --hostname="$BLACKBOX_SPAWN" --name="$BLACKBOX_SPAWN" --privileged --cgroupns=host --volume="${BLACKBOX_DIR}:${BLACKBOX_DIR}:ro" --volume="${BLACKBOX_USER_QUESTION_DIR}:${BLACKBOX_USER_QUESTION_DIR}:rw" --volume="${BLACKBOX_STORAGE_DIR}:${BLACKBOX_STORAGE_DIR}:rw" --volume="${BLACKBOX_ECR_TOKEN_DIR}:${BLACKBOX_ECR_TOKEN_DIR}:ro" "134148934511.dkr.ecr.us-east-1.amazonaws.com/hr/blackbox_2404:${BLACKBOX_MODULE_NAME}"
  fi

  : <<< blackbox.module.*.check.provision

  if [ -n "$BLACKBOX_PROVISION_WITH_OPTS" ]; then
    (
      {
        blackbox.framework.trace "BLACKBOX_PROVISION_WITH_OPTS" "$BLACKBOX_PROVISION_WITH_OPTS" <<<""
      }

      printf "\033[0;36m** BLACKBOX_PROVISION_WITH_OPTS:\033[0m {...}\n"
      printf "\033[0;37m%s\033[0m\n" "$(sed '1d; s/;$//g' <(declare -f BLACKBOX_PROVISION_WITH_OPTS))"
      printf "\033[0;37m--\033[0m\n"
      cat -n <(docker exec -i -w "$BLACKBOX_USER_QUESTION_DIR" "$BLACKBOX_SPAWN" "$BASH" /dev/stdin "$BLACKBOX_MODULE_NAME" "$BLACKBOX_MODULE_ACTION_NAME" "$BLACKBOX_QUESTION_ID" 2>&1 < <(sed "1c\source /blackbox/blackbox &>/dev/null" <(declare -f BLACKBOX_PROVISION_WITH_OPTS)))
      printf "\033[0;37m--\033[0m\n"
      printf "\n"
    ) | if ( tput setaf &>/dev/null ); then cat; else sed "s/\x1b\[[0-9;]*m//g"; fi
  fi

  if [ -n "$BLACKBOX_HEAP_WITH_OPTS" ]; then
    (
      {
        blackbox.framework.trace "BLACKBOX_HEAP_WITH_OPTS" "$BLACKBOX_HEAP_WITH_OPTS" <<<""
      }

      printf "\033[0;36m** BLACKBOX_HEAP_WITH_OPTS:\033[0m {...}\n"
      printf "\033[0;37m%s\033[0m\n" "$(sed '1d; s/;$//g' <(declare -f BLACKBOX_HEAP_WITH_OPTS))"
      printf "\033[0;37m--\033[0m\n"
      blackbox.framework.inventory.heap.allocate && {
        cat -n <(docker exec -i -w "$BLACKBOX_USER_QUESTION_DIR" "$BLACKBOX_SPAWN" "$BASH" /dev/stdin "$BLACKBOX_MODULE_NAME" "$BLACKBOX_MODULE_ACTION_NAME" "$BLACKBOX_QUESTION_ID" 2>&1 < <(sed "1c\source /blackbox/blackbox &>/dev/null" <(declare -f BLACKBOX_HEAP_WITH_OPTS)))
        blackbox.framework.inventory.heap.release
      }
      printf "\033[0;37m--\033[0m\n"
      printf "\n"
    ) | if ( tput setaf &>/dev/null ); then cat; else sed "s/\x1b\[[0-9;]*m//g"; fi
  fi

  if [ -n "$BLACKBOX_SNAPSHOT_WITH_OPTS" ]; then
    (
      {
        blackbox.framework.trace "BLACKBOX_SNAPSHOT_WITH_OPTS" "$BLACKBOX_SNAPSHOT_WITH_OPTS" <<<""
      }

      printf "\033[0;36m** BLACKBOX_SNAPSHOT_WITH_OPTS:\033[0m {...}\n"
      printf "\033[0;37m%s\033[0m\n" "$(sed '1d; s/;$//g' <(declare -f BLACKBOX_SNAPSHOT_WITH_OPTS))"
      printf "\033[0;37m--\033[0m\n"

      {
        # bashsupport disable=BP2001
        readarray -t collection < <(sed '1,2d; $d; s/^[[:space:]]\+//g; s/;$//g' <(declare -f BLACKBOX_SNAPSHOT_WITH_OPTS))

        # bashsupport disable=BP2001
        for option in "${collection[@]}"; do
          {
            blackbox.framework.trace "blackbox.framework.inventory.snapshot.push" "$option" <<<""
          }

          docker exec -i -w "$BLACKBOX_USER_QUESTION_DIR" "$BLACKBOX_SPAWN" "$BASH" /dev/stdin "$BLACKBOX_MODULE_NAME" "$BLACKBOX_MODULE_ACTION_NAME" "$BLACKBOX_QUESTION_ID" 2>&1 <<<"source /blackbox/blackbox &>/dev/null; blackbox.framework.inventory.snapshot.push '$option'"

          {
            blackbox.framework.trace "blackbox.framework.inventory.snapshot.digest" "$option" <<<""
          }

          # shellcheck disable=SC2155
          local snapshot_digest=$(docker exec -i -w "$BLACKBOX_USER_QUESTION_DIR" "$BLACKBOX_SPAWN" "$BASH" /dev/stdin "$BLACKBOX_MODULE_NAME" "$BLACKBOX_MODULE_ACTION_NAME" "$BLACKBOX_QUESTION_ID" 2>&1 <<<"source /blackbox/blackbox &>/dev/null; blackbox.framework.inventory.snapshot.digest '$option'")

          {
            blackbox.framework.trace "blackbox.framework.inventory.snapshot.pull" "$option" <<<""
          }

          # shellcheck disable=SC2155
          local snapshot_stream=$(cat -n <(docker exec -i -w "$BLACKBOX_USER_QUESTION_DIR" "$BLACKBOX_SPAWN" "$BASH" /dev/stdin "$BLACKBOX_MODULE_NAME" "$BLACKBOX_MODULE_ACTION_NAME" "$BLACKBOX_QUESTION_ID" 2>&1 <<<"source /blackbox/blackbox &>/dev/null; blackbox.framework.inventory.snapshot.pull '$option'"))

          printf "\033[0;37m--\033[0m\n"
          printf "\033[0;37m%s\033[0m\n" "$(<"$snapshot_digest")"
          printf "\033[0;37m--\033[0m\n"

          if [ "$(wc -l <<<"$snapshot_stream")" -gt "$BLACKBOX_BUILD_STREAM_DISPLAY_LINES" ]; then
            head -n "$(awk '{ printf "%.0f", sqrt($1); }' <<<"$BLACKBOX_BUILD_STREAM_DISPLAY_LINES")" <<<"$snapshot_stream"
            printf "        ...\n"
            tail -n "$(awk '{ printf "%.0f", sqrt($1); }' <<<"$BLACKBOX_BUILD_STREAM_DISPLAY_LINES")" <<<"$snapshot_stream"
          else
            cat <<<"${snapshot_stream:-"-empty-"}"
          fi

          printf "\033[0;37m--\033[0m\n"
          printf "\n"
        done
      }
    ) | if ( tput setaf &>/dev/null ); then cat; else sed "s/\x1b\[[0-9;]*m//g"; fi
  fi
}
