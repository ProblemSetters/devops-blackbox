#!/usr/bin/env bash
# @file framework/inventory/kafka.inventory
# @brief https://github.com/ProblemSetters/devops-blackbox/blob/2404/framework/inventory/kafka.inventory
# @description Inventory "kafka"

# @section blackbox.framework.inventory.*

# Provisions the "kafka" inventory
#
# @arg $1 readonly,type=string,default=kafka Inventory name
# @arg $2 type=...string Inventory additional packages
#
# @example
#  # Provision the "kafka" inventory
#  blackbox.framework.inventory.provision kafka
#
# @see blackbox.framework.inventory.provision
blackbox.framework.inventory.kafka() {
  typeset package_name=$1
  typeset -a with_packages=("${@:2}")

  {
    blackbox.framework.trace "${FUNCNAME[0]}" "$*" <<<""
  }

  sed "s/\x1b\[[0-9;]*m//g" <(dpkg-query -W "$package_name" "${with_packages[@]}" 2>&1)

  {
    # preinstalled setup fix: the existing kafka installation is outdated for Ubuntu 24.04
    rm -rf /usr/local/kafka
  }

  if ( dpkg-query -L "$package_name" "${with_packages[@]}" &>/dev/null ); then
    false

    return
  fi

  if [ -z "$(find /var/lib/apt/lists -mindepth 1 -newermt "5 minutes ago")" ]; then
    apt update
  fi

  DEBIAN_FRONTEND=noninteractive apt install -y --no-install-recommends software-properties-common openjdk-21-jre-headless wget && {
    wget -S --output-document="/tmp/kafka.tgz" --no-verbose https://downloads.apache.org/kafka/4.3.1/kafka_2.13-4.3.1.tgz && {
      mkdir /usr/local/kafka
      tar -zxvf /tmp/kafka.tgz --directory="/usr/local/kafka" --strip-components="1"
      rm /tmp/kafka.tgz
    }

    cp /blackbox/framework/inventory/kafka/rootfs/etc/systemd/system/kafka.service /etc/systemd/system/
  }
}
