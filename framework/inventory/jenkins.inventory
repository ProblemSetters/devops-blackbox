#!/usr/bin/env bash
# @file framework/inventory/jenkins.inventory
# @brief https://github.com/ProblemSetters/devops-blackbox/blob/2404/framework/inventory/jenkins.inventory
# @description Inventory "jenkins"

# @section blackbox.framework.inventory.*

# Provisions the "jenkins" inventory
#
# @arg $1 readonly,type=string,default=jenkins Inventory name
# @arg $2 type=...string Inventory additional packages
#
# @example
#  # Provision the "jenkins" inventory
#  blackbox.framework.inventory.provision jenkins
#
# @see blackbox.framework.inventory.provision
blackbox.framework.inventory.jenkins() {
  typeset package_name=$1
  typeset -a with_packages=("${@:2}")

  {
    blackbox.framework.trace "${FUNCNAME[0]}" "$*" <<<""
  }

  sed "s/\x1b\[[0-9;]*m//g" <(dpkg-query -W "$package_name" "${with_packages[@]}" 2>&1)

  if ( dpkg-query -L "$package_name" "${with_packages[@]}" &>/dev/null ); then
    false

    return
  fi

  if [ -z "$(find /var/lib/apt/lists -mindepth 1 -newermt "5 minutes ago")" ]; then
    apt update
  fi

  DEBIAN_FRONTEND=noninteractive apt install -y --no-install-recommends software-properties-common wget && {
    wget -S --output-document="/usr/share/keyrings/jenkins-keyring.asc" --no-verbose https://pkg.jenkins.io/debian-stable/jenkins.io-2023.key
    tee /etc/apt/sources.list.d/jenkins.list <<<"deb [signed-by=/usr/share/keyrings/jenkins-keyring.asc] https://pkg.jenkins.io/debian-stable binary/"

    local version=2.492.2

    apt update
    DEBIAN_FRONTEND=noninteractive apt install -y --no-install-recommends openjdk-17-jre-headless jenkins="$version" "${with_packages[@]}" && {
      install -m 0644 -D /blackbox/framework/inventory/jenkins/rootfs/etc/systemd/system/jenkins.service.d/override.conf /etc/systemd/system/jenkins.service.d/override.conf
    }
  }
}
