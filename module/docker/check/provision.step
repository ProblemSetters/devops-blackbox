#!/usr/bin/env bash
# @file module/docker/check/provision.step
# @brief https://github.com/ProblemSetters/devops-blackbox/blob/2204/module/docker/check/provision.step
# @description Docker module "check" action "provision" step

# @section blackbox.module.docker.check.*
blackbox.module.docker.check.provision() {
  : <<< blackbox.framework.module.abstract.check.provision:step

  docker exec -i "$BLACKBOX_SPAWN" service docker start && {
    docker exec -i -w "$BLACKBOX_USER_QUESTION_DIR" "$BLACKBOX_SPAWN" "$BASH" /dev/stdin "$BLACKBOX_MODULE_NAME" "$BLACKBOX_MODULE_ACTION_NAME" "$BLACKBOX_QUESTION_ID" 2>&1 <<<"source /blackbox/blackbox &>/dev/null; blackbox.framework.inventory.ecr.login"
  }
}
