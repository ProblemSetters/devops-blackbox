#!/usr/bin/env bash
# @file module/aws-stdl/check/evaluate/expect/artifact.expect
# @brief https://github.com/ProblemSetters/devops-blackbox/blob/2404/module/aws-stdl/check/evaluate/expect/artifact.expect
# @description Artifact collection expectant

# @section blackbox.module.aws-stdl.check.evaluate.expect.*
blackbox.module.aws-stdl.check.evaluate.expect.artifact() {
  # @section blackbox.module.aws-stdl.check.evaluate.expect.artifact.*

  # Expects a list of artifacts to collect
  #
  # @stdin Assert expression
  #
  # @noargs
  #
  # @stdout Formatted assert
  #
  # @example
  #   # Collect a list of artifacts
  #   cat <<ASSERT | blackbox.module.aws-stdl.check.evaluate.expect.artifact.collection
  #     printenv
  #     /etc/passwd
  #     whoami
  #     any-other-command-output-or-file
  #   ASSERT
  function blackbox.module.aws-stdl.check.evaluate.expect.artifact.collection() {
    # shellcheck disable=SC2155
    declare assert=$(</dev/stdin)

    printf "\n"

    {
      blackbox.framework.trace "${FUNCNAME[0]}" "$*" <<<""
    }

    eval "$(printf "function blackbox.expect.artifact.collection.__() {\n%s\n}" "$assert")"

    # bashsupport disable=BP2001
    readarray -t collection < <(sed '1,2d; $d; s/^[[:space:]]\+//g; s/;$//g' <(declare -f blackbox.expect.artifact.collection.__))

    # bashsupport disable=BP2001
    for artifact in "${collection[@]}"; do
      {
        blackbox.framework.trace "${FUNCNAME[0]}" "$artifact" <<<""
      }

      local artifact_cache="${BLACKBOX_STORAGE_DIR}/${artifact//[^A-Za-z0-9]/_}.artifact"
      # shellcheck disable=SC2155
      local artifact_stream=$(cat -n <(tee "$artifact_cache" < <("$BASH" /dev/stdin "$BLACKBOX_MODULE_NAME" "$BLACKBOX_MODULE_ACTION_NAME" "$BLACKBOX_QUESTION_ID" 2>&1 <<<"source /blackbox/blackbox &>/dev/null; ${artifact}")))

      sed -i "s/\x1b\[[0-9;]*m//g" "$artifact_cache"

      (
        printf "\033[0;35m** ARTIFACT:\033[0m %s \033[0;37m> %s (%d bytes)\033[0m\n" "${artifact//[^A-Za-z0-9]/_}.artifact" "$artifact_cache" "$(stat -c "%s" "$artifact_cache")"
        printf "\033[0;37m%s\033[0m\n" "$artifact"
        printf "\033[0;37m--\033[0m\n"

        if [ "$(wc -l <<<"$artifact_stream")" -gt "$BLACKBOX_BUILD_STREAM_DISPLAY_LINES" ]; then
          printf "\033[0;38m%s\n" "$(head -n "$(awk '{ printf "%.0f", sqrt($1); }' <<<"$BLACKBOX_BUILD_STREAM_DISPLAY_LINES")" <<<"$artifact_stream")"
          printf "\033[0;37m        ...\033[0m\n"
          printf "\033[0;38m%s\033[0m\n" "$(tail -n "$(awk '{ printf "%.0f", sqrt($1); }' <<<"$BLACKBOX_BUILD_STREAM_DISPLAY_LINES")" <<<"$artifact_stream")"
        else
          printf "\033[0;38m%s\033[0m\n" "$artifact_stream"
        fi

        printf "\033[0;37m--\033[0m\n"
        printf "\n"
      ) | if ( tput setaf &>/dev/null ); then cat; else sed "s/\x1b\[[0-9;]*m//g"; fi
    done
  }
}
